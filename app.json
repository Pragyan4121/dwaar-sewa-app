{
  "expo": {
    "name": "Dwaar Sewa",
    "slug": "dwaar-sewa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dwaarsewa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF5A3C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dwaarsewa.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dwaar Sewa uses your photo library so you can choose a profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5A3C"
      },
      "package": "com.dwaarsewa.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dwaar Sewa uses your photo library so you can choose a profile photo."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
